<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Elmish core for WebSharper apps</Description>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DefineConstants>$(DefineConstants);WEBSHARPER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="prelude.fs" />
    <Compile Include="../src/cmd.fs" />
    <Compile Include="../src/sub.fs" />
    <Compile Include="../src/ring.fs" />
    <Compile Include="../src/program.fs" />
    <None Include="wsconfig.json" />
  </ItemGroup>
  <ItemGroup>
    <ImportPackage Update="FSharp.Core" Version="6.0.*" />
    <PackageReference Include="WebSharper" Version="8.0.0.540" />
    <PackageReference Include="WebSharper.FSharp" Version="8.0.0.540" />
  </ItemGroup>
</Project>